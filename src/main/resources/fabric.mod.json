{
	"schemaVersion": 1,
	"id": "pfp",
	"version": "${version}",
	"name": "PFP Party Finder Premium",
	"description": "Blacklist, auto-kick and party tools for Hypixel SkyBlock dungeons and Kuudra: party history, player tags, repeat alerts, gear requirements and !pfp party commands.",
	"authors": ["Squexso", "ScaredOfWipe"],
	"contact": {
		"homepage": "https://github.com/Squexso/PFP-Party-Finder-Premium",
		"sources": "https://github.com/Squexso/PFP-Party-Finder-Premium",
		"issues": "https://github.com/Squexso/PFP-Party-Finder-Premium/issues"
	},
	"license": "MIT",
	"icon": "assets/pfp/icon.png",
	"environment": "client",
	"entrypoints": { "client": ["dev.pfp.PfpClient"] },
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
